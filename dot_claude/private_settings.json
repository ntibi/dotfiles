{
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__github__search_code",
      "mcp__github__get_file_contents",
      "mcp__github__search_issues",
      "mcp__github__list_issues"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "alwaysThinkingEnabled": true,
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ntibi/.claude/hooks/notify-permission.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ntibi/.claude/hooks/notify-done.sh"
          }
        ]
      }
    ]
  }
}
