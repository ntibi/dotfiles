{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Search*",
      "Edit",
      "Agent",
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskStop",
      "Skill",
      "AskUserQuestion",
      "Cron*",
      "mcp__plugin_context7__*",
      "mcp__github__get*",
      "mcp__github__list_*",
      "mcp__serena__*",
      "mcp__memory__recall_memory",
      "mcp__memory__search_by_tags",
      "mcp__memory__session_start",
      "mcp__kitty-terminal__read_terminal",
      "mcp__sentry__*",
      "mcp__plugin_slack_slack__slack_search_*",
      "mcp__plugin_slack_slack__slack_read_*",
      "mcp__claude_ai_Google_Calendar__gcal_list_*"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ntibi/.claude/hooks/notify-permission.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/ntibi/.claude/hooks/notify-done.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/ntibi/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "voiceEnabled": true
}
