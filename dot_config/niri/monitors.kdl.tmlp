
{{ if eq .chezmoi.hostname "ws" -}}
output "eDP-1" {
    mode "3840x2400@60"
    scale 2
    transform "normal"
    position x=0 y=0
}
{{ else if eq .chezmoi.hostname "desktop" -}}
output "DP-1" {
    mode "1920x1080@144"
    scale 1
    transform "normal"
    position x=0 y=0
}
output "DP-3" {
    mode "2560x1440@60"
    scale 1
    transform "normal"
    position x=1920 y=0
}
{{ else if eq .chezmoi.hostname "tibishift" -}}
output "eDP-1" {
    mode "1920x1080@120.030"
    scale 1.5
    transform "normal"
    position x=0 y=0
}
{{ end -}}
