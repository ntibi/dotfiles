{
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "spacing": 0,
    "fixed-center": true,
    "modules-left": ["niri/workspaces", "hyprland/workspaces", "custom/niri-scroll"],
    "modules-center": [],
    "modules-right": ["privacy", "pulseaudio", "backlight", "network", "custom/vpn", "cpu", "custom/cpugovernor", "custom/fan-ibm", "custom/fan-framework", "memory", "temperature", "battery", "clock", "tray"],

    "niri/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "all-outputs": false,
        "active-only": false,
        "format-icons": {
            "chat": "󰭹",
            "browser": "󰈹",
            "code": "",
            "terminal": "",
            "media": "",
            "default": "",
        }
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": false,
        "active-only": false
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 80,
        "separate-outputs": true
    },

    "privacy": {
        "icon-spacing": 4,
        "icon-size": 18,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-out",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ],
        "ignore-monitor": true,
        "ignore": [
            {
                "type": "audio-in",
                "name": "cava"
            },
            {
                "type": "screenshare",
                "name": "obs"
            }
        ]
    },


    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d (%a %d %b) %H:%M:%S %Z}",
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "temperature": {
        "thermal-zone": 0,
        "format": "{icon} {temperatureC}°C",
        "format-icons":[""],
        "interval": 10,
        "states": {
            "warning": 70,
            "critical": 85
        }
    },


    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "{icon}󱐋 {capacity}%+",
        "format-plugged": "{icon}󱐋 {capacity}%",
        "format-alt": "{icon} {time}",

        "format": "{icon} {capacity}%",
        "format-good": "{icon} {capacity}%", 
        "format-full": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 30
    },

    "network": {
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": "eth",
        "format-linked": "eth (no ip)",
        "format-disconnected": "󰖪",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "smooth-scrolling-threshold": 1,
        "format-icons": {
            "default": [""]
        },
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl -e4 -n0 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n0 set 5%-",
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10,
    },

    "custom/cpugovernor": {
        "interval": 30,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/custom_modules/cpu/governor_status.sh",
        "on-click": "$HOME/.config/waybar/custom_modules/cpu/governor_toggle.sh",
        "signal": 2,
    },
    "custom/vpn": {
        "interval": 5,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/custom_modules/mullvad/status.sh",
        "exec-if": "command -v mullvad",
        "on-click": "$HOME/.config/waybar/custom_modules/mullvad/toggle.sh",
    },
    "custom/fan-ibm": {
        "exec-if": "test -r /proc/acpi/ibm/fan",
        "format": "󰈐 {}",
        "interval": 5,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/custom_modules/ibm/fan_status.sh",
    },
    "custom/fan-framework": {
        "exec-if": "command -v ectool",
        "format": "󰈐 {}",
        "interval": 5,
        "return-type": "json",
        "on-click": "$HOME/.config/waybar/custom_modules/ibm/fan_toggle.sh",
        "exec": "$HOME/.config/waybar/custom_modules/framework/fan_status.sh",
    },

    "custom/niri-scroll": {
      "exec": "~/.config/waybar/custom_modules/niri/scroll.sh",
      "all-outputs": false,
      "restart-interval": 5,
      "format": "{}"
    }
}
