font = DejaVuSansM Nerd Font Mono
font-size = 13

width = 50%
height = 30%

anchor = bottom-left
horizontal = false
prompt-text = " > "

padding = 0 0 0 0
margin = 0 0 0 0

num-results = 0
result-spacing = 2

background-color = #2f2f2fdd
