# tofi configuration

# font
font = DejaVuSansM Nerd Font Mono
font-size = 13

# window dimensions
width = 50%
height = 30%

# position
anchor = bottom-left
horizontal = false
prompt-text = " > "

padding = 0 0 0 0
margin = 0 0 0 0

# results
num-results = 10
result-spacing = 4

# colors matching waybar/hyprland aesthetic
background-color = #2f2f2f
text-color = #cccccc
prompt-color = #cccccc
selection-color = #ffffff
selection-background = #444444
selection-background-padding = 4
selection-background-corner-radius = 0

# borders
border-width = 0
outline-width = 0
corner-radius = 0

# behavior
hide-cursor = true
drun-launch = true
terminal = alacritty
history = true
