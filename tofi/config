prompt-color = #ccccccff
selection-color = #ffffffff
selection-background = #444444ff
selection-background-padding = 0
selection-background-corner-radius = 0

border-width = 0
outline-width = 0
corner-radius = 0

hide-cursor = true
drun-launch = true
terminal = alacritty
history = true

scale = true

matching-algorithm = fuzzy
