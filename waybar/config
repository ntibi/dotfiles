{
	"layer": "top",
		"position": "bottom",
		"height": 24,
		"spacing": 0,
		"modules-left": ["hyprland/workspaces"],
		"modules-center": [],
		"modules-right": ["pulseaudio", "backlight", "network", "cpu", "custom/cpugovernor", "memory", "temperature", "battery", "clock"],

		"hyprland/workspaces": {
			"format": "{name}",
			"on-click": "activate",
			"all-outputs": false,
			"active-only": false
		},

		"hyprland/window": {
			"format": "{}",
			"max-length": 80,
			"separate-outputs": true
		},

		"clock": {
			"format": "{:%Y-%m-%d (%a %d %b) %H:%M:%S %Z}",
		},

		"cpu": {
			"format": " {usage}%",
			"interval": 2
		},

		"memory": {
			"format": " {percentage}%",
			"interval": 2
		},

		"temperature": {
			"thermal-zone": 0,
			"format": "{icon} {temperatureC}°C",
			"format-icons":[""],
			"interval": 10
		},


		"battery": {
			"states": {
				"warning": 30,
				"critical": 15
			},
			"format": "{icon} {capacity}%",
			"format-charging": "{icon}󱐋 {capacity}%+",
			"format-plugged": "{icon}󱐋 {capacity}%",
			"format-alt": "{icon} {time}",

			"format": "{icon} {capacity}%",
			"format-good": "{icon} {capacity}%", 
			"format-full": "{icon} {capacity}%",
			"format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"interval": 30
		},

		"network": {
			"format-wifi": " {essid} ({signalStrength}%)",
			"format-ethernet": "eth",
			"format-linked": "eth (no ip)",
			"format-disconnected": "睊",
			"format-alt": "{ifname}: {ipaddr}/{cidr}",
		},

		"pulseaudio": {
			"format": "{icon} {volume}%",
			"format-muted": " {volume}%",
			"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
			"scroll-step": 5,
			"smooth-scrolling-threshold": 1,
			"format-icons": {
				"default": [""]
			},
		},

		"backlight": {
			"device": "intel_backlight",
			"format": "{icon} {percent}%",
			"format-icons": ["󰃞", "󰃟", "󰃠"],
			"on-scroll-up": "brightnessctl -e4 -n0 set 5%+",
			"on-scroll-down": "brightnessctl -e4 -n0 set 5%-",
		},
		"custom/cpugovernor": {
			"interval": 30,
			"return-type": "json",
			"exec": "$HOME/.config/waybar/custom_modules/cpugovernor.sh",
			"on-click": "$HOME/.config/waybar/custom_modules/toggle_cpugovernor.sh",
			"signal": 2,
		},

}
